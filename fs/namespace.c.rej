-static int susfs_mnt_group_start = DEFAULT_SUS_MNT_GROUP_ID;
-
-#define CL_ZYGOTE_COPY_MNT_NS BIT(24) /* used by copy_mnt_ns() */
-#define CL_COPY_MNT_NS BIT(25) /* used by copy_mnt_ns() */
